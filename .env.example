# Copy to .env.local for local development, and add the same keys in your
# hosting provider's environment settings (e.g. Vercel > Settings > Environment Variables).

# Server-only key for the "Ask Dee" chat assistant (https://aistudio.google.com/apikey).
# Never prefix it with NEXT_PUBLIC_, that would ship it to every visitor's browser.
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-flash-latest).
GEMINI_MODEL=

# Optional: canonical site URL used for metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://dyahrini.space

# Optional: EmailJS overrides for the contact form (defaults are the current public IDs).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
